# AI providers. Configure one or both.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
# For lower Claude latency, you can choose a faster model supported by your account,
# for example: claude-haiku-4-5-20251001

# Used when the frontend sends provider=auto.
# Valid values: gemini, claude
DEFAULT_LLM_PROVIDER=gemini

DATABASE_URL=postgresql://username:password@host:port/dbname
READONLY_DATABASE_URL=postgresql://readonly_username:password@host:port/dbname

# Performance tuning
# Reuse PostgreSQL connections instead of opening a new cloud connection per tool call.
DB_POOL_MIN=1
DB_POOL_MAX=5
# Cache authorized table schemas briefly so repeated questions do not re-read information_schema.
SCHEMA_CACHE_TTL_SECONDS=300
# Prevent very large result sets from being sent through the LLM/tool loop.
MAX_QUERY_ROWS=500

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=your_email@example.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
FRONTEND_URL=http://localhost:5173

# New application registrations are currently assigned the fixed
# sales_manager role and Sales department in backend/api.py.
DEFAULT_ANNUAL_SALARY=20000
